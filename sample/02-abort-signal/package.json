    "@nestjs/platform-fastify": "11.1.28",
    "ai": "^7",
    "fastify": "5.12.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
